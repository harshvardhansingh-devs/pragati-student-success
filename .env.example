# Postgres / Supabase (Session pooler URI). Empty → local SQLite file.
DATABASE_URL=
JWT_SECRET=change-me

# AI Copilot & mentor briefs: any one key is enough; providers are tried in AI_PROVIDER_ORDER with automatic fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER_ORDER=gemini,groq,openrouter
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
