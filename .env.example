# Postgres / Supabase (Session pooler URI). Empty → local SQLite file.
DATABASE_URL=
JWT_SECRET=change-me

# AI Copilot & mentor briefs: any one key is enough; providers are tried in AI_PROVIDER_PRIORITY order with automatic fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER_PRIORITY=groq,openrouter,gemini
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# GEMINI_MODEL=gemini-3.8-flash
